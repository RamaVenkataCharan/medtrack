# ==============================================================================
# MedTrack Environment Configuration Template
# Copy this file to .env (or server/.env, client/.env, mobile/.env as needed)
# ==============================================================================

# Node / Environment Runtime
NODE_ENV=development
PORT=4000

# Database Configuration
# For local SQLite (default offline-capable engine):
DATABASE_URL=file:./server/db/medtrack.sqlite
# For Supabase PostgreSQL direct pooler connection:
# DATABASE_URL=postgresql://postgres:[YOUR-DB-PASSWORD]@db.vhkhdyraxtfajhfaewun.supabase.co:5432/postgres

# CORS Configuration
# Comma-separated list of allowed origins for the REST API
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8081,http://localhost:5173

# Supabase Auth & Cloud Configuration
SUPABASE_URL=https://vhkhdyraxtfajhfaewun.supabase.co
SUPABASE_ANON_KEY=sb_publishable_m1St44piDuyUpi8RUv5E0Q_gUd5sW16
# Secret Service Role Key (obtain from Supabase Dashboard -> Settings -> API -> service_role)
SUPABASE_SERVICE_KEY=your_supabase_service_role_secret_key_here

# Security & Auth Guardrails
# Set to 'false' in local offline development if testing without Supabase JWT
REQUIRE_AUTH=false

# Client-side Web (Vite) Environment Variables
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=https://vhkhdyraxtfajhfaewun.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_m1St44piDuyUpi8RUv5E0Q_gUd5sW16

# Mobile App (Expo) Environment Variables
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
EXPO_PUBLIC_SUPABASE_URL=https://vhkhdyraxtfajhfaewun.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_m1St44piDuyUpi8RUv5E0Q_gUd5sW16
